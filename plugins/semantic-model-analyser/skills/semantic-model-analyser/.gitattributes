# Every text file is stored with LF and checked out with LF, on every platform. The
# golden-file test compares datasets built from the fixtures, and a fixture checked out
# with CRLF on Windows and LF on Linux would make two correct runs disagree.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.tmdl  text eol=lf
*.pq    text eol=lf
*.m     text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf

*.png   binary
*.woff2 binary
