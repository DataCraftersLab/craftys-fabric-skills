expression ServerName = "localhost" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 11111111-1111-1111-1111-111111111111
	queryGroup: Parameters

	annotation PBI_ResultType = Text

expression 'Shared Staging' =
		let
		    Source = Sql.Database(ServerName, "Warehouse"),
		    Rows = Value.NativeQuery(Source, "SELECT CustomerKey, RegionKey, Name FROM dbo.Customer WHERE IsActive = 1", null, [EnableFolding = true])
		in
		    Rows
	lineageTag: 22222222-2222-2222-2222-222222222222

	annotation PBI_ResultType = Table

expression 'DirectQuery to AS - Upstream' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Upstream", "Upstream Model"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 33333333-3333-3333-3333-333333333333

