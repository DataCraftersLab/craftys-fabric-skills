table 'Projection Basis'
	lineageTag: j1
	calculationGroup
		precedence: 10

		/// Current period, no shift.
		calculationItem Current = SELECTEDMEASURE ()
			ordinal: 0

		calculationItem PY = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
			formatStringDefinition = SELECTEDMEASUREFORMATSTRING ()
			ordinal: 1

	column Name
		dataType: string
		sourceColumn: Name
		sortByColumn: Ordinal
		summarizeBy: none
		lineageTag: j2

	column Ordinal
		dataType: int64
		isHidden
		sourceColumn: Ordinal
		summarizeBy: none
		lineageTag: j3

	partition 'Projection Basis' = calculationGroup

