		lineageTag: 5ac83b92-877a-4ff6-beff-84c8f8e1ae41

	measure 'Margin Bucket' = SWITCH ( TRUE (), ISBLANK ( [Gross Margin %] ), BLANK (), [Gross Margin %] < 0.10, "Red", [Gross Margin %] < 0.25, "Amber", "Green" )
		isHidden
