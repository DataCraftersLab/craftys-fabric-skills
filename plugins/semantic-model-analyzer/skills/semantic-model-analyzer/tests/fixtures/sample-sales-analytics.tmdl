/// Central measure table holding all reusable KPIs, time-intelligence calculations and analytical metrics.
table '.Metrics'
	lineageTag: 809e8b6b-14fa-4523-ae1a-d219c456ab91

	measure 'Total Sales' = SUM ( Sales[Amount in Reporting Currency] )
		formatString: \$#,0
		displayFolder: 01 Sales
		lineageTag: 885a9a45-d5dc-418d-9c03-b9d067dd8e27

	measure 'Total Sales TC' = SUM ( Sales[Amount in Transaction Currency] )
		formatString: #,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: beafcc96-04b3-42c1-a8ff-d0c93bcb6f23

	measure 'Total Sales AC' = SUM ( Sales[Amount in Accounting Currency] )
		formatString: #,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: 578e54a5-4adf-41d9-a720-dc2fca23d064

	measure 'Gross Sales' = SUMX ( Sales, Sales[Amount in Reporting Currency] + Sales[Discount Amount] + Sales[Return Amount] )
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: 9efcc95c-3668-4d87-8927-616f8a4be232

	measure 'Sales PY' = CALCULATE ([Total Sales], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 Sales
		lineageTag: cd72e4c8-a615-45d8-afe4-b6dc3069eb31

	measure 'Sales YTD' = CALCULATE ( [Total Sales], DATESYTD ( 'Calendar'[Date] ) )
		formatString: \$#,0
		displayFolder: 01 Sales
		lineageTag: 63bf8a15-f96a-4be7-9782-f124c6d10fab

	measure 'Sales PYTD' = CALCULATE ( [Total Sales], DATESYTD ( SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) )
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: 4ac73ed3-3fbb-4566-9994-e569cb96099c

	measure 'Sales MTD' = CALCULATE ( [Total Sales], DATESMTD ( 'Calendar'[Date] ) )
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: 5d46326e-79ac-4975-a298-bb7021c24c7d

	measure 'Sales QTD' = CALCULATE ( [Total Sales], DATESQTD ( 'Calendar'[Date] ) )
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: be11111f-cfb6-44c7-b9e4-f1b71be88aa4

	measure 'Sales LTM' = CALCULATE ( [Total Sales], DATESINPERIOD ( 'Calendar'[Date], LASTDATE ( 'Calendar'[Date] ), -12, MONTH ) )
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: 7eca984b-494e-4d45-997e-deda412095b5

	measure 'Sales Rolling 3M' =
			
			// CALCULATE ( [Total Sales], DATESINPERIOD ( 'Calendar'[Date], LASTDATE ( 'Calendar'[Date] ), -3, MONTH ) )
			
			CALCULATE (
			    AVERAGEX (
			        VALUES ( 'Calendar'[Month] ),
			        [Total Sales]
			    ),
			    DATESINPERIOD ( 'Calendar'[Date], LASTDATE ( 'Calendar'[Date] ), -3, MONTH )
			)
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: a26f3de8-bac3-43f1-8c8f-2bf0f463d9a9

	measure 'Sales Prior Month' = CALCULATE ( [Total Sales], DATEADD ( 'Calendar'[Date], -1, MONTH ) )
		formatString: \$#,0
		isHidden
		displayFolder: 01 Sales
		lineageTag: 1461d264-266a-40b7-84ad-103899ab6a05

	measure 'YoY Sales $' = [Total Sales] - [Sales PY]
		formatString: \$#,0
