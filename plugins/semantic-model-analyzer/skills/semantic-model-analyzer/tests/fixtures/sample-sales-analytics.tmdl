	measure 'Customer Status (As Of)' =
			
			VAR RefDate = [_Ref Date]
			VAR ActiveCutoff = RefDate - 90
			VAR AtRiskCutoff = RefDate - 180
			VAR FirstSale =
			    CALCULATE (
			        MIN ( Sales[Invoice Date] ),
			        ALL ( 'Calendar' ),
			        Sales[Invoice Date] <= RefDate
			    )
			VAR LastSale =
			    CALCULATE (
			        MAX ( Sales[Invoice Date] ),
			        ALL ( 'Calendar' ),
			        Sales[Invoice Date] <= RefDate
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LastSale ),            "Never Purchased",
			        FirstSale >= ActiveCutoff,       "🟢New - First purchase in the last 90 days",
			        LastSale >= ActiveCutoff,        "🟣Returning -  Repeat purchase in last 90 days (not a first-timer)",
			        LastSale >= AtRiskCutoff,        "🟡At Risk - Last purchase was 90–180 days ago",
			        "🔴Churned - No purchase in the last 180+ days"
			    )
		isHidden
		displayFolder: 07 Customers
		lineageTag: 516d7ac0-ca81-425a-bdc2-1a7b01d8ffde

	measure 'At Risk Customers (As Of)' =
			
			VAR RefDate = [_Ref Date]
			VAR ActiveCutoff = RefDate - 90
			VAR AtRiskCutoff = RefDate - 180
			VAR Result =
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                VALUES ( Customer[CustomerKey] ),
			                VAR LastSale =
			                    CALCULATE (
			                        MAX ( Sales[Invoice Date] ),
			                        ALL ( 'Calendar' ),
			                        Sales[Invoice Date] <= RefDate
			                    )
			                RETURN
			                    NOT ISBLANK ( LastSale )
			                        && LastSale >= AtRiskCutoff
			                        && LastSale < ActiveCutoff
			            )
			        ),
			        ALL ( 'Calendar' )
			    )
			RETURN
			    Result
		formatString: 0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 319cd5fd-44cc-4a5b-a241-9495e06a2908

	measure '_Ref Date' = MAX('Calendar'[Date])
		formatString: General Date
		isHidden
		lineageTag: 8451705f-a990-4cbd-a707-155992108c3c

	measure 'Churned Customers (As Of)' =
			
			VAR RefDate = [_Ref Date]
			VAR AtRiskCutoff = RefDate - 180
			VAR Result =
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                VALUES ( Customer[CustomerKey] ),
			                VAR LastSale =
			                    CALCULATE (
			                        MAX ( Sales[Invoice Date] ),
			                        ALL ( 'Calendar' ),
			                        Sales[Invoice Date] <= RefDate
			                    )
			                RETURN
			                    NOT ISBLANK ( LastSale )
			                        && LastSale < AtRiskCutoff
			            )
			        ),
			        ALL ( 'Calendar' )
			    )
			RETURN
			    Result
		formatString: 0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 2e38e07b-8613-425c-8a8d-515ad929661b

