	measure 'Overview Insight' = VAR yoy = [YoY Sales %] VAR ach = [Budget Achievement %] VAR marDelta = [Margin Delta pp] RETURN SWITCH ( TRUE (), yoy >= 0.10 && ach >= 1, "Growth is broad-based - Sales up " & FORMAT ( yoy, "0.0%" ) & " YoY and tracking " & FORMAT ( ach, "0.0%" ) & " of plan." & IF ( NOT ISBLANK ( marDelta ), " Margin " & IF ( marDelta >= 0, "expanded ", "compressed " ) & FORMAT ( ABS ( marDelta ), "0.0" ) & " pp.", "" ), yoy >= 0 && ach >= 0.95, "On track - Sales up " & FORMAT ( yoy, "0.0%" ) & " and " & FORMAT ( ach, "0.0%" ) & " of plan. Watch margin trend.", yoy < 0 || ach < 0.80, "Performance below expectation - Sales " & FORMAT ( yoy, "+0.0%;-0.0%" ) & " and only " & FORMAT ( ach, "0.0%" ) & " of plan. Drill into Products / Customers to identify drag.", "Mixed signals - review performance page for pacing detail." )
