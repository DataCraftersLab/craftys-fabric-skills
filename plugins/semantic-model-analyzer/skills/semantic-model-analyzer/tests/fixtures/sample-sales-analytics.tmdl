		isHidden
		displayFolder: Field Param
		lineageTag: 547a1530-08f2-4a6a-b97c-9b521c9eba3f

	measure 'FMT Selected Metric PY Var %' = ```
			
			    SWITCH(
			            TRUE(),
			            SELECTEDVALUE('Metrics Parameter'[Metrics Parameter Order]) = 0, [FMT Sales Variance %],
			            SELECTEDVALUE('Metrics Parameter'[Metrics Parameter Order]) = 1, [FMT Volume GL Variance %],
			            SELECTEDVALUE('Metrics Parameter'[Metrics Parameter Order]) = 2, BLANK() // Please create measure and Update
			            )
			```
		isHidden
		displayFolder: Field Param
		lineageTag: 730c9ed0-e163-43db-88e5-b7b6fdabad4f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FMT Chart Label (Sales PY)' =
			
			IF( [Selected Metric YoY] < 0, [FMT Selected Metric PY Var %], BLANK())
		isHidden
		displayFolder: Field Param
		lineageTag: 289d688d-94e3-423d-bea8-78696be591a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FMT Chart Label (Sales)' =
			
			IF( [Selected Metric YoY] > 0, [FMT Selected Metric PY Var %], BLANK())
		isHidden
		displayFolder: Field Param
		lineageTag: 78fbb911-0491-4be8-baf9-5a81a8215b0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit Variance $' = [Gross Profit] - [Gross Profit PY]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 03 Cost & Margin
		lineageTag: b3f8ab69-cc31-46fb-96ab-4be5c18dc149

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Profit Variance %' = DIVIDE([Gross Profit Variance $], [Gross Profit PY])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Cost & Margin
		lineageTag: e8a7e80f-18e8-415e-af8c-fcddbdce7809

	measure 'FMT Gross Profit Variance %' = FORMAT([Gross Profit Variance %],  "▲ +0.0%;▼ -0.0%")
		isHidden
		displayFolder: 03 Cost & Margin
		lineageTag: d94f5cc3-127f-45a5-b3b1-c9a91e65cb1b

