	measure 'Projected Year-End' = ```
			
			VAR MonthsElapsed = DATEDIFF ( DATE ( YEAR ( TODAY () ), 1, 1 ), TODAY (), MONTH ) + 1 
			RETURN IF ( MonthsElapsed > 0, DIVIDE ( [Sales YTD], MonthsElapsed ) * 12, BLANK () )
