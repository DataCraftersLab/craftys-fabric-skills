	measure 'Volume Effect' = ```
			SUMX ( 
			    VALUES ( Product[ProductKey] ), 
			    VAR cyQty = [Total Volume GL] 
			    VAR pyQty = CALCULATE ( [Total Volume GL], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) 
			    VAR pyPrice = CALCULATE ( [Avg Selling Price/GL], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) 
			    RETURN ( cyQty - pyQty ) * pyPrice )
			```
		formatString: #,0
		isHidden
		displayFolder: 09 PVM
		lineageTag: 132de68e-4f06-4d5b-977e-a8762d810eec

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Price Effect' = ```
			SUMX (
			     VALUES ( Product[ProductKey] ), 
			     VAR cyPrice = [Avg Selling Price/GL] 
			     VAR pyPrice = CALCULATE ( [Avg Selling Price/GL], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) 
			     VAR pyQty = CALCULATE ( [Total Volume GL], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) ) 
			     RETURN 
			     ( cyPrice - pyPrice ) * pyQty )
			```
		formatString: #,0
		isHidden
		displayFolder: 09 PVM
		lineageTag: c07d670d-b8ab-4167-a208-7b53df2cb77c

		annotation PBI_FormatHint = {"isDecimal":true}

