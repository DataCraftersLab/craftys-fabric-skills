	measure 'Margin Delta pp' = IF ( NOT ISBLANK ( [Gross Margin %] ) && NOT ISBLANK ( [Gross Margin % PY] ), [Gross Margin %] - [Gross Margin % PY], BLANK () )
		formatString: #,0.0%;-#,0.0%;#,0.0%
