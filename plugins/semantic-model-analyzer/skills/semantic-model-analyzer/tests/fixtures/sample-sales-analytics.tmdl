	measure 'Product Quadrant' = ```
			
			VAR avgRev = AVERAGEX ( ALL ( Product[ProductKey] ), [Total Sales] ) 
			VAR avgMar = AVERAGEX ( ALL ( Product[ProductKey] ), [Budget Achievement %] ) 
			VAR thisRev = [Total Sales] 
			VAR thisMar = [Budget Achievement %] 
			RETURN SWITCH ( TRUE (), 
			    thisRev >= avgRev && thisMar >= avgMar, "Star", 
			    thisRev >= avgRev && thisMar < avgMar, "Cash Cow", 
			    thisRev < avgRev && thisMar >= avgMar, "Question", 
			    "Dog" 
			    )
			```
		isHidden
		displayFolder: 08 Products
