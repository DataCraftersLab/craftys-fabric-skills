	measure 'Product Pareto %' = VAR runningRev = CALCULATE ( [Total Sales], TOPN ( [Product Rank], ALL ( Product ), [Total Sales], DESC ) ) VAR grandTotal = CALCULATE ( [Total Sales], ALL ( Product ) ) RETURN DIVIDE ( runningRev, grandTotal )
