	measure 'YoY Arrow' = VAR g = [YoY Sales %] RETURN IF ( ISBLANK ( g ), BLANK (), IF ( g >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( g ), "0.0%" ) )
		isHidden
		displayFolder: 02 Growth
		lineageTag: 5b382d1f-ab98-4cb9-9ddb-c3e6ff13b621

	measure 'Growth Trend Label' = SWITCH ( TRUE (), [YoY Sales %] >= 0.10, "Accelerating", [YoY Sales %] >= 0.03, "Steady", [YoY Sales %] >= -0.03, "Flat", "Declining" )
		isHidden
		displayFolder: 02 Growth
		lineageTag: fe49da5e-3a22-4792-8a56-5042ef084f27

	measure 'Has Cost Data' = NOT ISBLANK ( SUM ( Sales[Cost in Reporting Currency] ) )
