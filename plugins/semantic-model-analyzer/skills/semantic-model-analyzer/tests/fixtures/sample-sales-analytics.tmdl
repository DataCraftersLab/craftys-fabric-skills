	measure 'Active Customers' =
			
			// CALCULATE ( DISTINCTCOUNT ( Sales[Customer Key] ), Sales[Amount in Reporting Currency] <> 0 )
			VAR RefDate = [_Ref Date]
			VAR WindowStart = RefDate - 90
			VAR Result =
			    CALCULATE (
			        DISTINCTCOUNT ( Sales[CustomerKey] ),
			        'Calendar'[Date] >= WindowStart,
			        'Calendar'[Date] <= RefDate,
			        ALL ( 'Calendar' )
			    )
			RETURN
			    Result
		formatString: #,0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 5417217e-4847-4e75-a71e-86d0b687720a

	measure 'Active Customers PY' = CALCULATE ( [Active Customers], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: #,0
		isHidden
		displayFolder: 07 Customers
		lineageTag: aba071ea-d42f-4cd8-b92d-b38bf9a76bac

	measure 'Customer Net Delta vs PY' = [Active Customers] - [Active Customers PY]
		formatString: #,0
		isHidden
		displayFolder: 07 Customers
		lineageTag: d6332a40-02e3-4bc0-ad67-d605897b66a3

	measure 'New Customers (Period)' = ```
			
			// VAR currentDates = VALUES ( 'Calendar'[Date] ) 
			// VAR newCusts = FILTER ( VALUES ( Customer[Customer Key] ), 
			// VAR firstSale = CALCULATE ( MIN ( Sales[Invoice Date] ) ) 
			// RETURN firstSale IN currentDates ) 
			// RETURN COUNTROWS ( newCusts )
			
			VAR RefDate = [_Ref Date]
			   
			VAR WindowStart = RefDate - 90
			VAR Result =
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                VALUES ( Customer[CustomerKey] ),
			                VAR FirstPurchase =
			                    CALCULATE ( MIN ( Sales[Invoice Date] ) )
			                RETURN
			                    NOT ISBLANK ( FirstPurchase )
			                        && FirstPurchase >= WindowStart
			                        && FirstPurchase <= RefDate
			            )
			        ),
			        ALL ( 'Calendar' )
			    )
			RETURN
			    Result
			```
		formatString: 0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 8de7f3d2-3e01-4676-90af-8a84e0fed5ee

	measure 'Returning Customers' =
			
			//[Active Customers] - [New Customers (Period)]
			VAR RefDate = [_Ref Date]
			VAR WindowStart = RefDate - 90
			VAR Result =
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                VALUES ( Customer[CustomerKey] ),
			                VAR FirstPurchase =
			                    CALCULATE (
			                        MIN ( Sales[Invoice Date] ),
			                        ALL ( 'Calendar' )
			                    )
			                VAR PurchasedInWindow =
			                    CALCULATE (
			                        COUNTROWS ( Sales ),
			                        'Calendar'[Date] >= WindowStart,
			                        'Calendar'[Date] <= RefDate,
			                        ALL ( 'Calendar' )
			                    ) > 0
			                RETURN
			                    PurchasedInWindow
			                        && NOT ISBLANK ( FirstPurchase )
			                        && FirstPurchase < WindowStart
			            )
			        ),
			        ALL ( 'Calendar' )
			    )
			RETURN
			    Result
		formatString: #,0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 6143233e-55ff-43d8-9a09-bfb952b29f22

	measure 'New Customer Sales' = ```
			
			VAR newCustList = FILTER ( VALUES ( Sales[CustomerKey] ), 
			VAR firstSale = CALCULATE ( MIN ( Sales[Invoice Date] ), ALL ( 'Calendar' ) ) 
			RETURN firstSale IN VALUES ( 'Calendar'[Date] ) ) 
			RETURN CALCULATE ( [Total Sales], KEEPFILTERS ( newCustList ) )
			```
		formatString: \$#,0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 712a9d81-6713-4e52-80bc-81adfbf3a130

	measure 'Avg Sales per Customer' = DIVIDE ( [Total Sales], [Active Customers] )
		formatString: \$#,0
		isHidden
		displayFolder: 07 Customers
		lineageTag: 35e73674-80b9-4f87-9523-e6432917ac72

	measure 'Customer Lifecycle Status' = ```
			
			// VAR firstSale = CALCULATE ( MIN ( Sales[Invoice Date] ), ALL ( 'Calendar' ) ) 
			// VAR lastSale = CALCULATE ( MAX ( Sales[Invoice Date] ), ALL ( 'Calendar' ) ) 
			// VAR today = TODAY () 
			// RETURN SWITCH ( TRUE (), ISBLANK ( lastSale ), "Inactive", 
			//     firstSale >= EDATE ( today, -3 ), "New", 
			//     lastSale >= EDATE ( today, -3 ), "Active", 
			//     lastSale >= EDATE ( today, -12 ), "At Risk", 
			//     "Churned" 
			//     )
			VAR RefDate = [_Ref Date]
			VAR ActiveCutoff = RefDate - 90
			VAR AtRiskCutoff = RefDate - 180
			VAR FirstSale =
			    CALCULATE (
			        MIN ( Sales[Invoice Date] ),
			        ALL ( 'Calendar' ),
			        Sales[Invoice Date] <= RefDate
			    )
			VAR LastSale =
			    CALCULATE (
			        MAX ( Sales[Invoice Date] ),
			        ALL ( 'Calendar' ),
			        Sales[Invoice Date] <= RefDate
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LastSale ),            "Never Purchased",
			        FirstSale >= ActiveCutoff,       "New",
			        LastSale >= ActiveCutoff,        "Returning",
			        LastSale >= AtRiskCutoff,        "At Risk",
			        "Churned"
			    )
			```
		isHidden
		displayFolder: 07 Customers
		lineageTag: 1cf718fb-d812-49c4-9bbd-03862531781e

	measure 'Customer Concentration Top 10%' = ```
			
			VAR _topN = ROUND ( [Active Customers] * 0.10, 0 ) 
			VAR topRev = CALCULATE ( [Total Sales], TOPN ( _topN, VALUES ( Customer[CustomerKey] ), [Total Sales], DESC ) ) 
			RETURN 
			DIVIDE ( topRev, [Total Sales] )
			```
		formatString: 0.0%
		isHidden
		displayFolder: 07 Customers
		lineageTag: ce42d785-80bd-449b-b6df-4024b2704f87

