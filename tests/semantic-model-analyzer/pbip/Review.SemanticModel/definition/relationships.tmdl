relationship Sales_Customer
	fromColumn: Sales.CustomerKey
	toColumn: Customer.CustomerKey

relationship Sales_Date_Order
	fromColumn: Sales.OrderDateKey
	toColumn: Date.DateKey

relationship Sales_Date_Ship
	isActive: false
	fromColumn: Sales.ShipDateKey
	toColumn: Date.DateKey

relationship Sales_Date_Due
	isActive: false
	fromColumn: Sales.DueDateKey
	toColumn: Date.DateKey

relationship Customer_Region
	crossFilteringBehavior: bothDirections
	fromColumn: Customer.RegionKey
	toColumn: Region.RegionKey

relationship Sales_Region_Direct
	fromCardinality: many
	toCardinality: many
	fromColumn: Sales.RegionKey
	toColumn: Region.RegionKey

relationship Ghost
	fromColumn: Sales.MissingKey
	toColumn: 'Not Handed Over'.Key

