/// Dates, marked as the model's date table.
table Calendar

	column Date
		isKey
		formatString: Long Date
		lineageTag: 8f1c0a20-1111-4a30-9d21-aa0000000001
		summarizeBy: none
		dataType: dateTime
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	/// The calendar year, as a whole number.
	column Year
		dataType: int64
		formatString: 0
		lineageTag: 8f1c0a20-1111-4a30-9d21-aa0000000002
		summarizeBy: none
		sourceColumn: Year

	column 'Month Name'
		dataType: string
		lineageTag: 8f1c0a20-1111-4a30-9d21-aa0000000003
		summarizeBy: none
		sortByColumn: Month Number
		sourceColumn: Month Name

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		isHidden
		dataType: int64
		formatString: 0
		lineageTag: 8f1c0a20-1111-4a30-9d21-aa0000000004
		summarizeBy: none
		sourceColumn: Month Number

	column 'Is Current Month' =
			VAR Today = TODAY ()
			RETURN
				'Calendar'[Month Number] = MONTH ( Today )
					&& 'Calendar'[Year] = YEAR ( Today )
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 8f1c0a20-1111-4a30-9d21-aa0000000005
		summarizeBy: none

	partition Calendar = m
		mode: import
		source =
				let
					Source = Sql.Database("server", "db")
				in
					Source

	annotation PBI_ResultType = Table

table Product

	column ProductKey
		isKey
		isHidden
		dataType: int64
		formatString: 0
		lineageTag: 8f1c0a20-2222-4a30-9d21-bb0000000001
		summarizeBy: none
		sourceColumn: ProductKey

	/// Customer-facing product name.
	column 'Product Name'
		dataType: string
		displayFolder: Attributes
		lineageTag: 8f1c0a20-2222-4a30-9d21-bb0000000002
		summarizeBy: none
		sourceColumn: ProductName
		dataCategory: Place

	column Category
		dataType: string
		displayFolder: Attributes\Hierarchy
		lineageTag: 8f1c0a20-2222-4a30-9d21-bb0000000003
		summarizeBy: none
		sourceColumn: Category

	column 'List Price'
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Pricing
		lineageTag: 8f1c0a20-2222-4a30-9d21-bb0000000004
		summarizeBy: average
		sourceColumn: ListPrice

	column 'Price Band' = SWITCH ( TRUE (), Product[List Price] < 10, "Low", Product[List Price] < 100, "Mid", "High" )
		dataType: string
		displayFolder: Pricing
		lineageTag: 8f1c0a20-2222-4a30-9d21-bb0000000005
		summarizeBy: none

table Sales

	column SalesKey
		isKey
		isHidden
		dataType: int64
		formatString: 0
		lineageTag: 8f1c0a20-3333-4a30-9d21-cc0000000001
		summarizeBy: none
		sourceColumn: SalesKey

	column Amount
		dataType: decimal
		formatString: \$#,0
		lineageTag: 8f1c0a20-3333-4a30-9d21-cc0000000002
		summarizeBy: sum
		sourceColumn: Amount

	column Quantity
		dataType: int64
		formatString: #,0
		lineageTag: 8f1c0a20-3333-4a30-9d21-cc0000000003
		summarizeBy: sum
		sourceColumn: Quantity

	/// Line total before discount.
	column 'Gross Amount' = Sales[Amount] * Sales[Quantity]
		dataType: decimal
		formatString: \$#,0
		lineageTag: 8f1c0a20-3333-4a30-9d21-cc0000000004
		summarizeBy: sum

	/// Revenue recognised in the period.
	measure 'Total Sales' = SUM ( Sales[Amount] )
		formatString: \$#,0
		displayFolder: 01 Core
		lineageTag: 8f1c0a20-4444-4a30-9d21-dd0000000001

	measure 'Total Quantity' = SUM ( Sales[Quantity] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 8f1c0a20-4444-4a30-9d21-dd0000000002

	measure 'Average Price' = DIVIDE ( [Total Sales], [Total Quantity] )
		formatString: \$#,0.00
		displayFolder: 02 Ratios
		lineageTag: 8f1c0a20-4444-4a30-9d21-dd0000000003

	measure 'Sales YTD' = CALCULATE ( [Total Sales], DATESYTD ( 'Calendar'[Date] ) )
		formatString: \$#,0
		displayFolder: 03 Time\YTD
		lineageTag: 8f1c0a20-4444-4a30-9d21-dd0000000004

	measure _SalesColor = "#58A545"
		isHidden
		displayFolder: 99 Helpers
		lineageTag: 8f1c0a20-4444-4a30-9d21-dd0000000005

	partition Sales = m
		mode: import
		queryGroup: Facts
		source =
				let
					Source = Sql.Database("server", "db"),
					Rows = Table.SelectRows(Source, each [Amount] > 0)
				in
					Rows

/// A contiguous date table, generated in DAX rather than loaded.
table 'Date Bridge'

	column 'Bridge Date'
		isNameInferred
		dataType: dateTime
		formatString: Long Date
		lineageTag: 8f1c0a20-5555-4a30-9d21-ee0000000001
		summarizeBy: none
		sourceColumn: [Date]

	column 'Bridge Year'
		isNameInferred
		dataType: int64
		formatString: 0
		lineageTag: 8f1c0a20-5555-4a30-9d21-ee0000000002
		summarizeBy: none
		sourceColumn: [Year]

	partition 'Date Bridge' = calculated
		mode: import
		source =
				ADDCOLUMNS (
					CALENDARAUTO (),
					"Year", YEAR ( [Date] )
				)

	annotation PBI_Id = 3f9c1de0

/// Read straight from the lakehouse — no expression of its own.
table Territory

	column TerritoryKey
		isKey
		dataType: int64
		lineageTag: 8f1c0a20-6666-4a30-9d21-ff0000000001
		summarizeBy: none
		sourceColumn: TerritoryKey

	column 'Territory Name'
		dataType: string
		lineageTag: 8f1c0a20-6666-4a30-9d21-ff0000000002
		summarizeBy: none
		sourceColumn: TerritoryName

	partition Territory = entity
		mode: directLake
		source
			entityName: dim_territory
			expressionSource: 'DirectLake - Sales'

	changedProperty = Name
